    "axios": "^1.7.2",
    "dayjs": "^1.11.11"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/js-yaml": "^4.0.9",
    "@types/deep-diff": "^1.0.5",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
