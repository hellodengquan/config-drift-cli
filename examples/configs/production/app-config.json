{
  "ui": {
    "defaultLanguage": "zh-CN",
    "pageSize": 20,
    "theme": "light"
  },
  "logging": {
    "maxFiles": 10,
    "maxSize": "100MB",
    "filePath": "/var/log/app.log",
    "level": "warn"
  },
  "feature": {
    "multiLanguage": true,
    "darkMode": false,
    "aiRecommend": true,
    "newCheckout": false
  },
  "auth": {
    "refreshTokenExpiry": 86400,
    "tokenExpiry": 3600,
    "jwtSecret": "prod-jwt-secret-2024"
  },
  "security": {
    "enable2FA": true,
    "passwordMinLength": 8,
    "maxLoginAttempts": 5,
    "sessionTimeout": 1800
  },
  "redis": {
    "cacheTTL": 3600,
    "db": 0,
    "port": 6379,
    "host": "redis-prod.example.com"
  },
  "database": {
    "pool": {
      "idleTimeout": 30000,
      "max": 20,
      "min": 5
    },
    "name": "ecommerce",
    "port": 5432,
    "host": "db-prod-new.example.com"
  },
  "app": {
    "debug": false,
    "port": 8080,
    "version": "2.1.0",
    "name": "电商平台"
  }
}
