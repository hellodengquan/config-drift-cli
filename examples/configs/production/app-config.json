{
  "app": {
    "name": "电商平台",
    "version": "2.1.0",
    "port": 8080,
    "debug": false
  },
  "database": {
    "host": "db-prod.example.com",
    "port": 5432,
    "name": "ecommerce",
    "pool": {
      "min": 5,
      "max": 20,
      "idleTimeout": 30000
    }
  },
  "redis": {
    "host": "redis-prod.example.com",
    "port": 6379,
    "db": 0,
    "cacheTTL": 3600
  },
  "security": {
    "sessionTimeout": 1800,
    "maxLoginAttempts": 5,
    "passwordMinLength": 8,
    "enable2FA": true
  },
  "auth": {
    "jwtSecret": "{{vault:prod/jwt/secret}}",
    "dbPassword": "{{ vault : prod/db/password }}",
    "apiKey": "{{secret:prod/api/main-key}}",
    "tokenExpiry": 3600,
    "refreshTokenExpiry": 86400
  },
  "feature": {
    "newCheckout": false,
    "aiRecommend": true,
    "darkMode": false,
    "multiLanguage": true
  },
  "logging": {
    "level": "warn",
    "filePath": "/var/log/app.log",
    "maxSize": "100MB",
    "maxFiles": 10
  },
  "ui": {
    "theme": "light",
    "pageSize": 20,
    "defaultLanguage": "zh-CN"
  }
}
