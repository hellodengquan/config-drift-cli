# 生产环境环境变量
# 加载时间: 系统启动时

APP_NAME=电商平台  # 应用名称
APP_PORT=8080  # 服务端口
APP_DEBUG=false  # 调试模式

DB_HOST=db-prod.example.com
DB_PORT=5432
DB_NAME=ecommerce
DB_PASSWORD="{{vault:prod/db/password}}"  # 数据库密码从vault读取

REDIS_HOST=redis-prod.example.com
REDIS_PORT=6379
# REDIS_PASSWORD=  # 已禁用，使用无密码认证

ENABLE_METRICS=true
ENABLE_TRACING=false
MAX_CONNECTIONS=100

# LOG_LEVEL=info
LOG_LEVEL=warn
